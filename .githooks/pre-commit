#!/usr/bin/env powershell
# Fallback pre-commit hook (Windows PowerShell): validate `daily-log.csv` (exactly 4 columns, non-empty)

$staged = git diff --cached --name-only

if ($staged -match '^daily-log\.csv$') {
    $csvPath = 'daily-log.csv'
    if (-not (Test-Path $csvPath)) {
        Write-Error "$csvPath not found"
        exit 1
    }

    # Prefer running the canonical Python validator if available
    $py = (Get-Command python3 -ErrorAction SilentlyContinue).Path
    if (-not $py) { $py = (Get-Command python -ErrorAction SilentlyContinue).Path }
    if ($py) {
        & $py scripts/validate_csv.py
        $rc = $LASTEXITCODE
        if ($rc -ne 0) { exit $rc }
        exit 0
    }

    # Fallback: minimal validation if Python not present
    $lines = Get-Content $csvPath -Encoding UTF8
    $bom = [char]0xfeff
    for ($i = 0; $i -lt $lines.Length; $i++) {
        $line = $lines[$i]
        if ($line.Length -gt 0 -and $line[0] -eq $bom) { $line = $line.Substring(1) }
        if ($line.Trim() -eq '') { continue }
        $cols = $line -split ','
        if ($cols.Count -ne 4) {
            Write-Error "Invalid CSV line $($i + 1): expected 4 columns, found $($cols.Count)"
            exit 1
        }
    }
}

exit 0
